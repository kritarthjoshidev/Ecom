# Backend Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# Replace with your MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ecommerce

# JWT Secret for signing authentication tokens
JWT_SECRET=super_secret_jwt_key_antigravity_ecommerce_2026

# JWT Expiration
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
